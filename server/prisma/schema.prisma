generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("SEED")
  tags        String   @default("[]")
  parentId    String?
  parent      Idea?    @relation("IdeaRelation", fields: [parentId], references: [id])
  children    Idea[]   @relation("IdeaRelation")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
